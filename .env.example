# Copy to .env and set your own prefix and client key.
# Optional: python3 scripts/configure.py generates both without printing secrets.
API_PREFIX=replace-with-random-prefix
AUTHORIZATION=replace-with-random-client-key
# Container path; put your access token or session JSON in ./data/token.txt.
# Native-only deployments can leave this unset and configure the native backend below.
CHATGPT_TOKEN_FILE=data/token.txt
DEFAULT_MODEL=gpt-6-thinking
DEFAULT_REASONING_EFFORT=high
CHATGPT_BASE_URL=https://chatgpt.com
PROXY_URL=
HISTORY_DISABLED=true
ENABLE_GATEWAY=false
SCHEDULED_REFRESH=false
RETRY_TIMES=0
AUTO_CONTINUE=true
AUTO_CONTINUE_MAX_ROUNDS=4
AUTO_CONTINUE_MAX_TOKENS=65536
DEFAULT_TOOL_MAX_TOKENS=65536
AUTO_CONTINUE_TIMEOUT=600
CONVERSATION_TIMEOUT=180
RECOVERY_MAX_SECONDS=120
RECOVERY_MAX_READS=120
WEBSOCKET_IDLE_TIMEOUT=15

# Codex Responses backend: web (ChatGPT conversation bridge) or native.
RESPONSES_BACKEND=web
RESPONSES_WEBSOCKET_ENABLED=false
CODEX_WEB_CLIENT_VERSIONS=0.166.0
CODEX_WEB_CONTEXT_WINDOW=32768
CODEX_WEB_TOOL_MODE=direct
# Local encrypted checkpoints are opt-in. store=false never writes them.
# RESPONSES_STATE_DIR=/app/data/response-checkpoints
# RESPONSES_STATE_SECRET=<generate-a-random-secret-and-keep-it-private>
# Native mode only; choose your actual authorized Responses endpoint.
# RESPONSES_UPSTREAM_BASE_URL=https://api.openai.com/v1
# RESPONSES_UPSTREAM_KEY=<upstream-key-stays-on-the-gateway>
# RESPONSES_UPSTREAM_PROXY=http://host.docker.internal:7897
# For your own Codex login, explicitly mount its auth file read-only and use:
# RESPONSES_CODEX_AUTH_FILE=/run/secrets/codex-auth.json
# RESPONSES_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
# RESPONSES_ALLOWED_MODELS=gpt-6.1-terra
# Current Codex subscription transport uses V2 Responses compaction triggers.
# Explicit selection; a failed compact request is never retried via another route.
# RESPONSES_COMPACTION_MODE=responses
